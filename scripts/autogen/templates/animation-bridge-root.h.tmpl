/**
 * @brief A lightweight bridge for applying animations to a {{VIEW_CLASS}}.
 *
 * {{BRIDGE_CLASS}} is stack-allocated (no heap allocation) and provides
 * type-safe fluent chaining for animating {{VIEW_CLASS}} properties.
 *
 * Typically created via {{VIEW_CLASS}}::Animate():
 * @code
 *   auto anim = Animation::New();
 *   view.Animate(anim)
 *     .Opacity(0.5f, 300_ms);
 *   anim.Play();
 * @endcode
 */
class DALI_UI_API {{BRIDGE_CLASS}}
{
public:
{{METHODS}}

protected:
  {{BRIDGE_CLASS}}(Animation animation, {{VIEW_CLASS}} view);

  void ExtendIfNeeded(Duration delay, Duration duration)
  {
    float required = delay.InSeconds() + duration.InSeconds();
    if(required > mAnimation.GetDuration())
    {
      mAnimation.SetDuration(required);
    }
  }

  Animation mAnimation;
  {{VIEW_CLASS}} mView;
  void*     mReserved{nullptr}; ///< Reserved for future use

private:
  friend class {{VIEW_CLASS}};
};

} // namespace Ui
} // namespace Dali
