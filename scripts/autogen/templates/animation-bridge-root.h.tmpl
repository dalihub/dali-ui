/**
 * @brief A lightweight bridge for applying animations to a {{VIEW_CLASS}}.
 *
 * {{BRIDGE_CLASS}} is stack-allocated (no heap allocation) and provides
 * type-safe fluent chaining for animating {{VIEW_CLASS}} properties.
 *
 * Typically created via {{VIEW_CLASS}}::Animate():
 * @code
 *   auto anim = Animation::New();
 *   view.Animate(anim)
 *     .Opacity(0.5f, 300_ms);
 *   anim.Play();
 * @endcode
 * {{SINCE}}
 */
class DALI_UI_API {{BRIDGE_CLASS}}
{
public:
  // The copy, move and destruction of a bridge are defined by the library, not
  // inline, so that the library keeps control of the data members below.

  /**
   * @brief Destructor.
   * {{LIFECYCLE_SINCE}}
   */
  ~{{BRIDGE_CLASS}}();

  /**
   * @brief Copy constructor.
   * {{LIFECYCLE_SINCE}}
   * @param[in] rhs The bridge to copy
   */
  {{BRIDGE_CLASS}}(const {{BRIDGE_CLASS}}& rhs);

  /**
   * @brief Copy assignment operator.
   * {{LIFECYCLE_SINCE}}
   * @param[in] rhs The bridge to copy
   * @return A reference to this
   */
  {{BRIDGE_CLASS}}& operator=(const {{BRIDGE_CLASS}}& rhs);

  /**
   * @brief Move constructor.
   * {{LIFECYCLE_SINCE}}
   * @param[in] rhs The bridge to move from
   */
  {{BRIDGE_CLASS}}({{BRIDGE_CLASS}}&& rhs) noexcept;

  /**
   * @brief Move assignment operator.
   * {{LIFECYCLE_SINCE}}
   * @param[in] rhs The bridge to move from
   * @return A reference to this
   */
  {{BRIDGE_CLASS}}& operator=({{BRIDGE_CLASS}}&& rhs) noexcept;

{{METHODS}}

protected:
  {{BRIDGE_CLASS}}(Animation animation, {{VIEW_CLASS}} view);

  void ExtendIfNeeded(Duration delay, Duration duration)
  {
    float required = delay.InSeconds() + duration.InSeconds();
    if(required > mAnimation.GetDuration())
    {
      mAnimation.SetDuration(required);
    }
  }

  Animation mAnimation;
  {{VIEW_CLASS}} mView;
  void*     mReserved{nullptr}; ///< Reserved for future use

private:
  friend class {{VIEW_CLASS}};
};

} // namespace Ui
} //namespace DALI_NAMESPACE
