namespace Dali
{
namespace Ui
{

class {{VIEW_CLASS}};

namespace Internal
{

class {{IMPL_CLASS}};
using {{IMPL_CLASS}}Ptr = IntrusivePtr<{{IMPL_CLASS}}>;

/**
 * @brief Internal implementation of {{SPEC_CLASS}}.
 */
class DALI_UI_API {{IMPL_CLASS}} : public BaseObject
{
public:
  static {{IMPL_CLASS}}Ptr New();

  struct Entry
  {
    using ApplyFunction = void(*)(Animation&, {{VIEW_CLASS}}, const Entry&);

    Property::Index index;
    Property::Value value;
    Duration        duration;
    AlphaFunction   alpha;
    Duration        delay;
    ApplyFunction   apply;
  };

  static void ApplyAnimateTo(Animation& animation, {{VIEW_CLASS}} view, const Entry& entry);
  static void ApplyAnimateBy(Animation& animation, {{VIEW_CLASS}} view, const Entry& entry);

  void AddAnimateToEntry(Property::Index index, Property::Value value,
                         Duration duration, AlphaFunction alpha, Duration delay);
  void AddAnimateToEntry(Property::Index index, Property::Value value,
                         Duration duration, AlphaFunction alpha, Duration delay,
                         Entry::ApplyFunction apply);
  void AddAnimateByEntry(Property::Index index, Property::Value value,
                         Duration duration, AlphaFunction alpha, Duration delay);
  void AddAnimateByEntry(Property::Index index, Property::Value value,
                         Duration duration, AlphaFunction alpha, Duration delay,
                         Entry::ApplyFunction apply);

  void ApplyEntries(Animation animation, {{VIEW_CLASS}} view) const;

  /// Returns true if any entry uses AlphaFunction::REVERSE.
  bool ContainsReverseAlpha() const;

  /// Returns true if any entry targets a layout-owned bounds property
  /// (POSITION, POSITION_X, POSITION_Y, SIZE, SIZE_WIDTH, SIZE_HEIGHT). Used
  /// by LayoutTransition to reject visual specs that try to drive bounds —
  /// bounds animation belongs to the bounds-effect channel.
  bool ContainsLayoutBoundsProperty() const;

{{MANUAL_APPLY_DECLARATIONS}}

protected:
  {{IMPL_CLASS}}();
  ~{{IMPL_CLASS}}() override;

  std::vector<Entry> mEntries;

private:
  {{IMPL_CLASS}}(const {{IMPL_CLASS}}&) = delete;
  {{IMPL_CLASS}}({{IMPL_CLASS}}&&) = delete;
  {{IMPL_CLASS}}& operator=(const {{IMPL_CLASS}}&) = delete;
  {{IMPL_CLASS}}& operator=({{IMPL_CLASS}}&&) = delete;
};

inline Internal::{{IMPL_CLASS}}& GetImpl({{SPEC_CLASS}}& obj)
{
  BaseObject& handle = obj.GetBaseObject();
  return static_cast<Internal::{{IMPL_CLASS}}&>(handle);
}

inline const Internal::{{IMPL_CLASS}}& GetImpl(const {{SPEC_CLASS}}& obj)
{
  const BaseObject& handle = obj.GetBaseObject();
  return static_cast<const Internal::{{IMPL_CLASS}}&>(handle);
}

