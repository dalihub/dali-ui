# Doxygen Configuration for XML output
PROJECT_NAME           = "DALi UI"
PROJECT_NUMBER         = 2.0.0
OUTPUT_DIRECTORY       = build/doc
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

INPUT                  = dali-ui-foundation/public-api \
                         dali-ui-foundation/integration-api \
                         dali-ui-elements/public-api \
                         dali-ui-components/public-api
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */internal/*

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# XML Output (Required for Doxybook2)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO

# Preprocessor
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = dali-ui-foundation
