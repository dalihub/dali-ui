IF(DEFINED DALI_UI_SAMPLE_COMMON_INCLUDED)
  RETURN()
ENDIF()
SET(DALI_UI_SAMPLE_COMMON_INCLUDED TRUE)
SET(DALI_UI_SAMPLE_COMMON_DIR "${CMAKE_CURRENT_LIST_DIR}")

INCLUDE(GNUInstallDirs)

IF(WIN32)
  FIND_PACKAGE(dali2-core CONFIG REQUIRED)
  FIND_PACKAGE(dali2-adaptor CONFIG REQUIRED)
  FIND_PACKAGE(dali2-ui-foundation CONFIG REQUIRED)
  FIND_PACKAGE(dali2-ui-components CONFIG REQUIRED)

  SET(DALI_UI_SAMPLE_LIBRARIES
    dali2-ui-components::dali2-ui-components
    dali2-ui-foundation::dali2-ui-foundation
    dali2-adaptor::dali2-adaptor
    dali2-core::dali2-core
  )

  # The top-level sample build applies these directory-wide. Keep standalone
  # sample configuration ABI-compatible as well.
  IF(MSVC AND NOT DALI_UI_SAMPLE_MSVC_OPTIONS_INHERITED)
    SET(DALI_UI_SAMPLE_COMPILE_OPTIONS /vmg /utf-8 /wd4251 /wd4275)
    SET(DALI_UI_SAMPLE_COMPILE_DEFINITIONS __restrict__=__restrict)
  ENDIF()
ELSE()
  FIND_PACKAGE(PkgConfig REQUIRED)
  PKG_CHECK_MODULES(DALICORE REQUIRED IMPORTED_TARGET dali2-core)
  PKG_CHECK_MODULES(DALIADAPTOR REQUIRED IMPORTED_TARGET dali2-adaptor)
  PKG_CHECK_MODULES(DALI_UI_FOUNDATION REQUIRED IMPORTED_TARGET dali2-ui-foundation)
  PKG_CHECK_MODULES(DALI_UI_COMPONENTS REQUIRED IMPORTED_TARGET dali2-ui-components)

  SET(DALI_UI_SAMPLE_LIBRARIES
    PkgConfig::DALI_UI_COMPONENTS
    PkgConfig::DALI_UI_FOUNDATION
    PkgConfig::DALIADAPTOR
    PkgConfig::DALICORE
  )
  SET(DALI_UI_SAMPLE_COMPILE_OPTIONS
    -fvisibility=hidden
    -Wall
    -fPIE
    -rdynamic
  )
  SET(DALI_UI_SAMPLE_COMPILE_DEFINITIONS HIDE_DALI_INTERNALS)
ENDIF()

FUNCTION(DALI_SET_SAMPLE_RESOURCES TARGET_NAME RESOURCE_NAME RESOURCE_SOURCE_DIRECTORY)
  IF(NOT TARGET ${TARGET_NAME})
    MESSAGE(FATAL_ERROR "Sample resource target does not exist: ${TARGET_NAME}")
  ENDIF()
  IF(NOT IS_DIRECTORY "${RESOURCE_SOURCE_DIRECTORY}")
    MESSAGE(FATAL_ERROR "Sample resource directory does not exist: ${RESOURCE_SOURCE_DIRECTORY}")
  ENDIF()

  SET(RESOURCE_INSTALL_DIRECTORY
    "${CMAKE_INSTALL_DATADIR}/dali/samples/${RESOURCE_NAME}/res"
  )
  IF(WIN32)
    # sample-runtime-windows.cpp sets the working directory to the directory
    # containing the executable before main(). Keep this path relative so the
    # complete installed tree can be moved without rebuilding the samples.
    SET(RESOURCE_RUNTIME_DIRECTORY "../${RESOURCE_INSTALL_DIRECTORY}")
  ELSE()
    SET(RESOURCE_RUNTIME_DIRECTORY
      "${CMAKE_INSTALL_PREFIX}/${RESOURCE_INSTALL_DIRECTORY}"
    )
    STRING(REPLACE "\\" "/" RESOURCE_RUNTIME_DIRECTORY "${RESOURCE_RUNTIME_DIRECTORY}")
  ENDIF()

  TARGET_COMPILE_DEFINITIONS(${TARGET_NAME} PRIVATE
    RESOURCES_DIR="${RESOURCE_RUNTIME_DIRECTORY}/"
  )

  STRING(MAKE_C_IDENTIFIER "${RESOURCE_NAME}" RESOURCE_INSTALL_KEY)
  GET_PROPERTY(RESOURCE_INSTALL_REGISTERED GLOBAL
    PROPERTY "DALI_SAMPLE_RESOURCE_${RESOURCE_INSTALL_KEY}_REGISTERED"
  )
  IF(NOT RESOURCE_INSTALL_REGISTERED)
    INSTALL(
      DIRECTORY "${RESOURCE_SOURCE_DIRECTORY}/"
      DESTINATION "${RESOURCE_INSTALL_DIRECTORY}"
    )
    SET_PROPERTY(GLOBAL
      PROPERTY "DALI_SAMPLE_RESOURCE_${RESOURCE_INSTALL_KEY}_REGISTERED" TRUE
    )
  ENDIF()
ENDFUNCTION()

FUNCTION(DALI_ADD_SAMPLE EXE_NAME)
  ADD_EXECUTABLE(${EXE_NAME} ${ARGN})

  IF(WIN32)
    TARGET_SOURCES(${EXE_NAME} PRIVATE
      "${DALI_UI_SAMPLE_COMMON_DIR}/sample-runtime-windows.cpp"
    )
  ENDIF()

  SET_TARGET_PROPERTIES(${EXE_NAME} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/bin"
  )

  IF(CMAKE_BUILD_TYPE MATCHES Debug)
    TARGET_COMPILE_DEFINITIONS(${EXE_NAME} PRIVATE DEBUG_ENABLED)
  ENDIF()

  TARGET_LINK_LIBRARIES(${EXE_NAME} PRIVATE ${DALI_UI_SAMPLE_LIBRARIES})
  TARGET_INCLUDE_DIRECTORIES(${EXE_NAME} PRIVATE ${DALI_UI_SAMPLE_INCLUDE_DIRS})
  TARGET_COMPILE_DEFINITIONS(${EXE_NAME} PRIVATE ${DALI_UI_SAMPLE_COMPILE_DEFINITIONS})
  TARGET_COMPILE_OPTIONS(${EXE_NAME} PRIVATE ${DALI_UI_SAMPLE_COMPILE_OPTIONS})
  # Source files are UTF-8. MSVC otherwise uses the active code page to
  # interpret string literals, corrupting non-ASCII sample text such as emoji.
  IF(MSVC)
    TARGET_COMPILE_OPTIONS(${EXE_NAME} PRIVATE /utf-8)
  ENDIF()

  IF(IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/res")
    GET_FILENAME_COMPONENT(SAMPLE_RESOURCE_NAME "${CMAKE_CURRENT_SOURCE_DIR}" NAME)
    DALI_SET_SAMPLE_RESOURCES(
      ${EXE_NAME}
      ${SAMPLE_RESOURCE_NAME}
      "${CMAKE_CURRENT_SOURCE_DIR}/res"
    )
  ENDIF()

  INSTALL(TARGETS ${EXE_NAME} RUNTIME DESTINATION bin)
ENDFUNCTION()
