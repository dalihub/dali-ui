@startuml layout-class-diagram
!theme plain
title DALi UI Foundation - Layout Related Classes

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle

' ========== External (DALi) ==========
package "DALi (external)" as dali {
  class "Ui::Control" as Control <<handle>>
  class "Dali::Integration::Processor" as Processor <<interface>>
  class "Dali::Internal::CustomActor" as CustomActor <<impl>>
}

' ========== Public API (Handles) ==========
' Note: Child add/remove uses Actor::Add/Remove. View provides Insert(index, View) and RemoveAllChildren().
' LayoutManager is stored as a Trait (ReservedTraitId::LAYOUT_MANAGER), attached via View::AttachLayoutManager().
package "Dali::Ui (Public API)" as public_api {
  class "View" as View <<handle>> {
    + New() : View
    + Measure(widthConstraint, heightConstraint) : MeasuredSize
    + Arrange(bounds) : MeasuredSize
    + SetRequestedWidth(float)
    + SetRequestedHeight(float)
    + GetSize() : MeasuredSize
    + InvalidateMeasure()
    + InvalidateArrange()
    + AttachLayoutManager(UniquePtr<LayoutManager>)
    __
    - View(ViewImpl&)
    - View(CustomActor*)
  }

  class "Layout" as Layout <<handle>> {
    + New() : Layout
    + Add(Actor)  /' inherited from Actor '/
    + Remove(Actor)  /' inherited from Actor '/
    + Insert(index, View)
    + RemoveAllChildren()
    + RemoveAllChildren(RemovePolicy)
    + Remove(View, RemovePolicy)
    + GetChildCount() : uint32_t  /' inherited from Actor (actor tree) '/
    + GetChildAt(index) : Actor  /' inherited from Actor (actor tree) '/
    + GetChildViewCount() : uint32_t
    + GetChildViewAt(index) : View
    + IndexOfChildView(View) : int32_t
    + Contents(initializer_list<View>) : Layout&
    __
    - Layout(Integration::LayoutImpl&)
    - Layout(CustomActor*)
  }

  class "StackLayout" as StackLayout <<handle>> {
    + New(StackOrientation) : StackLayout
    + SetOrientation(StackOrientation) : StackLayout&
    + SetSpacing(float) : StackLayout&
    + {static} GetParams(View) : StackLayoutParams
    + {static} GetOrCreateParams(View) : StackLayoutParams
    + {static} SetLayoutWeight(View, float)
  }

  class "FlexLayout" as FlexLayout <<handle>> {
    + New() : FlexLayout
    + SetDirection(FlexDirection) : FlexLayout&
    + SetWrap(FlexWrap) : FlexLayout&
    + SetJustifyContent(FlexJustify) : FlexLayout&
    + SetAlignItems(FlexAlign) : FlexLayout&
    + SetAlignContent(FlexAlign) : FlexLayout&
    + {static} GetParams(View) : FlexLayoutParams
    + {static} GetOrCreateParams(View) : FlexLayoutParams
    + {static} SetFlexGrow(View, float)
    + {static} SetFlexShrink(View, float)
    + {static} SetFlexBasis(View, float)
    + {static} SetAlignSelf(View, FlexAlign)
  }

  class "GridLayout" as GridLayout <<handle>> {
    + New() : GridLayout
    + AddRowDefinition(GridLength)
    + AddColumnDefinition(GridLength)
    + SetRowSpacing(float) : GridLayout&
    + SetColumnSpacing(float) : GridLayout&
    + {static} GetParams(View) : GridLayoutParams
    + {static} GetOrCreateParams(View) : GridLayoutParams
    + {static} SetRow(View, uint32_t)
    + {static} SetColumn(View, uint32_t)
    + {static} SetRowSpan(View, uint32_t)
    + {static} SetColumnSpan(View, uint32_t)
  }

  class "AbsoluteLayout" as AbsoluteLayout <<handle>> {
    + New() : AbsoluteLayout
    + {static} GetParams(View) : AbsoluteLayoutParams
    + {static} GetOrCreateParams(View) : AbsoluteLayoutParams
    + {static} SetLayoutBounds(View, LayoutRect)
    + {static} GetLayoutBounds(View) : LayoutRect
    + {static} SetLayoutFlags(View, AbsoluteLayoutFlags)
    + {static} GetLayoutFlags(View) : AbsoluteLayoutFlags
  }

  class "AbsoluteLayoutParams" as AbsoluteLayoutParams <<handle>> {
    + SetBounds(LayoutRect) : AbsoluteLayoutParams&
    + GetBounds() : LayoutRect
    + SetFlags(AbsoluteLayoutFlags) : AbsoluteLayoutParams&
    + GetFlags() : AbsoluteLayoutFlags
  }

  class "FlexLayoutParams" as FlexLayoutParams <<handle>> {
    + SetFlexGrow(float) : FlexLayoutParams&
    + SetFlexShrink(float) : FlexLayoutParams&
    + SetFlexBasis(float) : FlexLayoutParams&
    + SetAlignSelf(FlexAlign) : FlexLayoutParams&
  }

  class "GridLayoutParams" as GridLayoutParams <<handle>> {
    + SetRow(uint32_t) : GridLayoutParams&
    + SetColumn(uint32_t) : GridLayoutParams&
    + SetRowSpan(uint32_t) : GridLayoutParams&
    + SetColumnSpan(uint32_t) : GridLayoutParams&
  }

  class "StackLayoutParams" as StackLayoutParams <<handle>> {
    + SetWeight(float) : StackLayoutParams&
    + GetWeight() : float
  }

  class "LayoutController" as LayoutController <<singleton>> {
    + {static} Get(Window) : LayoutController&
    + RequestLayout(ViewImpl*)
    + OnWindowResize(width, height)
    + ProcessLayouts()
    __
    - mImpl : unique_ptr<LayoutControllerImpl>
  }
}

' ========== Integration API (Implementations) ==========
' ViewImpl: LayoutManager, child API, Contents are integration-only (e.g. ButtonImpl).
' ViewImpl provides AttachLayoutManager(); derived layout impls attach their manager in OnInitialize().
package "Dali::Ui::Integration (Implementation)" as integration {
  class "ViewImpl" as ViewImpl <<impl>> {
    + {static} New() : Ui::View
    - mRequestedWidth
    - mRequestedHeight
    - mLayoutManager
    - mChildren : ChildContainer
    __
    + AttachLayoutManager(UniquePtr<LayoutManager>)
    + GetLayoutManager() : LayoutManager*
    + HasLayoutManager() : bool
    + HasLayoutCallback() : bool
    + Insert(index, Ui::View)
    + RemoveAllChildren()
    + RemoveAllChildren(RemovePolicy)
    + OnChildAdd(Actor&)
    + OnChildRemove(Actor&)
    + OnChildOrderChanged(Actor)
    + GetChildViewCount() : uint32_t
    + GetChildViewAt(index) : Ui::View
    + IndexOfChildView(Ui::View) : int32_t
    + Contents(initializer_list<View>) : ViewImpl&
    __
    + Measure(widthConstraint, heightConstraint) : MeasuredSize
    + Arrange(bounds) : MeasuredSize
    + OnMeasure(w, h) : MeasuredSize
    + OnArrange(bounds) : MeasuredSize
    + InvalidateMeasure()
    + GetParentLayout() : Ui::Layout
    + IsLayout() : bool
    + RegisterWithLayoutController()
    # GetChildren() : ChildContainer&
  }

  class "LayoutImpl" as LayoutImpl <<impl>> {
    + {static} New() : Ui::Layout
    __
    # LayoutImpl()
  }

  class "StackLayoutImpl" as StackLayoutImpl <<impl>> {
    + {static} New(StackOrientation) : Ui::StackLayout
  }

  class "FlexLayoutImpl" as FlexLayoutImpl <<impl>> {
    + {static} New() : Ui::FlexLayout
  }

  class "GridLayoutImpl" as GridLayoutImpl <<impl>> {
    + {static} New() : Ui::GridLayout
  }

  class "AbsoluteLayoutImpl" as AbsoluteLayoutImpl <<impl>> {
    + {static} New() : Ui::AbsoluteLayout
  }

  class "LayoutControllerImpl" as LayoutControllerImpl <<impl>> {
    - mWindow : Window
    - mPendingViews : unordered_set<ViewImpl*>
    __
    + RequestLayout(ViewImpl*)
    + ProcessLayouts()
    + Process(postProcess) : void
    - ProcessLayoutRoot(ViewImpl*)
  }

  class "AbsoluteLayoutParamsImpl" as AbsoluteLayoutParamsImpl <<trait>> {
    + SetBounds(LayoutRect)
    + GetBounds() : LayoutRect
    + SetFlags(AbsoluteLayoutFlags)
    + GetFlags() : AbsoluteLayoutFlags
    + {static} Get(ViewImpl&) : AbsoluteLayoutParamsImpl*
    + {static} GetOrCreate(ViewImpl&) : AbsoluteLayoutParamsImpl&
  }

  class "FlexLayoutParamsImpl" as FlexLayoutParamsImpl <<trait>> {
    + SetFlexGrow(float)
    + SetFlexShrink(float)
    + SetFlexBasis(float)
    + SetAlignSelf(FlexAlign)
    + {static} Get(ViewImpl&) : FlexLayoutParamsImpl*
    + {static} GetOrCreate(ViewImpl&) : FlexLayoutParamsImpl&
  }

  class "GridLayoutParamsImpl" as GridLayoutParamsImpl <<trait>> {
    + SetRow(uint32_t)
    + SetColumn(uint32_t)
    + SetRowSpan(uint32_t)
    + SetColumnSpan(uint32_t)
    + {static} Get(ViewImpl&) : GridLayoutParamsImpl*
    + {static} GetOrCreate(ViewImpl&) : GridLayoutParamsImpl&
  }

  class "StackLayoutParamsImpl" as StackLayoutParamsImpl <<trait>> {
    + SetWeight(float)
    + GetWeight() : float
    + {static} Get(ViewImpl&) : StackLayoutParamsImpl*
    + {static} GetOrCreate(ViewImpl&) : StackLayoutParamsImpl&
  }
}

' ========== Layout Managers ==========
package "Layout Managers" as managers {
  abstract class "LayoutManager" as LayoutManager {
    + {abstract} Measure(ViewImpl*, widthConstraint, heightConstraint) : MeasuredSize
    + {abstract} Arrange(ViewImpl*, bounds) : MeasuredSize
    __
    # GetChildViewCount(ViewImpl*) : uint32_t
    # GetChildViewAt(ViewImpl*, index) : View
    # IsStandalone(ViewImpl*) : bool
    __
    - mImpl : Impl*
  }

  class "StackLayoutManager" as StackLayoutManager {
    Measure(ViewImpl*, w, h) : MeasuredSize
    Arrange(ViewImpl*, bounds) : MeasuredSize
  }

  class "FlexLayoutManager" as FlexLayoutManager {
    Measure(ViewImpl*, w, h) : MeasuredSize
    Arrange(ViewImpl*, bounds) : MeasuredSize
  }

  class "GridLayoutManager" as GridLayoutManager {
    Measure(ViewImpl*, w, h) : MeasuredSize
    Arrange(ViewImpl*, bounds) : MeasuredSize
  }

  class "AbsoluteLayoutManager" as AbsoluteLayoutManager {
    Measure(ViewImpl*, w, h) : MeasuredSize
    Arrange(ViewImpl*, bounds) : MeasuredSize
  }
}

' ========== Layout Types ==========
package "Layout Types" as types {
  class "MeasuredSize" as MeasuredSize <<struct>> {
    + width : float
    + height : float
    + MeasuredSize(w, h)
  }

  class "LayoutRect" as LayoutRect <<struct>> {
    + x, y, width, height : float
  }

  class "WRAP_CONTENT" as WrapContent <<constant>> {
    WRAP_CONTENT = -1.0f
  }

  class "MATCH_PARENT" as MatchParent <<constant>> {
    MATCH_PARENT = -2.0f
  }
}

' ========== Inheritance (Public API) ==========
Control <|-- View
View <|-- Layout
Layout <|-- StackLayout
Layout <|-- FlexLayout
Layout <|-- GridLayout
Layout <|-- AbsoluteLayout

' ========== Inheritance (Integration / p-impl) ==========
Processor <|.. LayoutControllerImpl : implements
CustomActor <|-- ViewImpl
ViewImpl <|-- LayoutImpl
LayoutImpl <|-- StackLayoutImpl
LayoutImpl <|-- FlexLayoutImpl
LayoutImpl <|-- GridLayoutImpl
LayoutImpl <|-- AbsoluteLayoutImpl

' ========== Handle -> Impl (p-impl) ==========
View ..> ViewImpl : uses
Layout ..> LayoutImpl : uses
StackLayout ..> StackLayoutImpl : uses
FlexLayout ..> FlexLayoutImpl : uses
GridLayout ..> GridLayoutImpl : uses
AbsoluteLayout ..> AbsoluteLayoutImpl : uses
LayoutController o-- LayoutControllerImpl : owns

' ========== LayoutManager ==========
LayoutManager <|-- StackLayoutManager
LayoutManager <|-- FlexLayoutManager
LayoutManager <|-- GridLayoutManager
LayoutManager <|-- AbsoluteLayoutManager

ViewImpl ..> LayoutManager : owns via Trait (AttachLayoutManager)

' ========== Layout Params (Handle -> Impl) ==========
AbsoluteLayoutParams ..> AbsoluteLayoutParamsImpl : uses
FlexLayoutParams ..> FlexLayoutParamsImpl : uses
GridLayoutParams ..> GridLayoutParamsImpl : uses
StackLayoutParams ..> StackLayoutParamsImpl : uses

AbsoluteLayout ..> AbsoluteLayoutParams : creates
FlexLayout ..> FlexLayoutParams : creates
GridLayout ..> GridLayoutParams : creates
StackLayout ..> StackLayoutParams : creates

' ========== Layout Params Traits ==========
AbsoluteLayoutManager ..> AbsoluteLayoutParamsImpl : reads
FlexLayoutManager ..> FlexLayoutParamsImpl : reads
GridLayoutManager ..> GridLayoutParamsImpl : reads
StackLayoutManager ..> StackLayoutParamsImpl : reads

' ========== Types ==========
ViewImpl ..> MeasuredSize : returns
ViewImpl ..> LayoutRect : uses
LayoutManager ..> MeasuredSize : returns
LayoutManager ..> LayoutRect : uses

@enduml
