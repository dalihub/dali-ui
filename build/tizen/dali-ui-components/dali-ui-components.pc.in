prefix=@PREFIX@
exec_prefix=@EXEC_PREFIX@
libdir=@LIB_DIR@
includedir=@INCLUDE_DIR@

Name: dali-ui-components
Description: DALi UI Components Library providing components such as Button
Version: @DALI_UI_VERSION@
Requires: dali@DALI_API_MAJOR@-ui-foundation
Libs: -L${libdir} -l@PROJECT_LIB_NAME@
Cflags: -I${includedir}
