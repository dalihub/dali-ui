prefix=@PREFIX@
exec_prefix=@EXEC_PREFIX@
libdir=@LIB_DIR@
includedir=@INCLUDE_DIR@

Name: dali-ui-elements
Description: DALi UI Elements Library providing essential elements such as TextLabel and ImageView
Version: @DALI_UI_VERSION@
Requires: dali2-ui-foundation
Libs: -L${libdir} -ldali2-ui-foundation
Cflags: -I${includedir}
